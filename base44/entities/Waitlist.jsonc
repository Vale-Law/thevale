{
  "name": "Waitlist",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "format": "email"
    },
    "state": {
      "type": "string",
      "description": "US state the attorney is licensed in (full name)"
    },
    "notified": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "email",
    "state"
  ]
}