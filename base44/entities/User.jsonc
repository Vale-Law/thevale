{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "client",
        "attorney",
        "admin",
        "user"
      ],
      "default": "user"
    },
    "account_type": {
      "type": "string",
      "enum": [
        "client",
        "attorney"
      ]
    },
    "preferredLanguage": {
      "type": "string"
    },
    "requiresSpanishAttorney": {
      "type": "boolean"
    }
  }
}