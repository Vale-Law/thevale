{
  "name": "Attorney",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "practice_area": {
      "type": "string",
      "enum": [
        "Family Law",
        "Immigration",
        "Business Formation",
        "Personal Injury"
      ]
    },
    "practice_areas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "photo": {
      "type": "string"
    },
    "consult_fee": {
      "type": "number"
    },
    "typical_retainer": {
      "type": "number"
    },
    "location": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "distance": {
      "type": "string"
    },
    "rating": {
      "type": "number"
    },
    "review_count": {
      "type": "number"
    },
    "years_experience": {
      "type": "number"
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "languages_spoken": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "spanish_speaker": {
      "type": "boolean"
    },
    "bilingual_staff": {
      "type": "boolean"
    },
    "interpreter_available": {
      "type": "boolean"
    },
    "translated_documents": {
      "type": "boolean"
    },
    "verified": {
      "type": "boolean"
    },
    "board_certified": {
      "type": "boolean"
    },
    "board_cert_body": {
      "type": "string",
      "description": "Certifying body for board certification, e.g. Texas Board of Legal Specialization"
    },
    "board_cert_specialty": {
      "type": "string",
      "description": "Specialty area of board certification"
    },
    "board_cert_document": {
      "type": "string",
      "description": "Uploaded proof of board certification (private file uri)"
    },
    "board_cert_approved": {
      "type": "boolean",
      "default": false
    },
    "education": {
      "type": "string"
    },
    "bar_admission": {
      "type": "string"
    },
    "specialties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "bio": {
      "type": "string"
    },
    "available_slots": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "user_id": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "bar_number": {
      "type": "string"
    },
    "bar_state": {
      "type": "string"
    },
    "office_location": {
      "type": "string"
    },
    "phone_number": {
      "type": "string"
    },
    "id_document": {
      "type": "string"
    },
    "bar_card_document": {
      "type": "string"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "rejected"
      ],
      "default": "pending"
    },
    "verified_date": {
      "type": "string",
      "format": "date"
    },
    "profile_attestation": {
      "type": "boolean",
      "description": "Attorney attested they wrote their profile and it is accurate and compliant with their state's advertising rules"
    },
    "profile_attestation_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "name",
    "practice_area"
  ]
}